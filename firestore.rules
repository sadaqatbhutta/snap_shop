rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isBusinessOwner(businessId) {
      return isAuthenticated() &&
        (businessId == request.auth.uid ||
         get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerEmail == request.auth.token.email ||
         isPlatformAdmin());
    }

    function isAgent(businessId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/businesses/$(businessId)/agents/$(request.auth.uid));
    }

    function isAdmin(businessId) {
      return isBusinessOwner(businessId) ||
        (isAgent(businessId) && get(/databases/$(database)/documents/businesses/$(businessId)/agents/$(request.auth.uid)).data.role == 'admin');
    }

    // Client may only touch product/config fields — never billing, usage, or channel secrets.
    function clientSafeBusinessKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'name', 'description', 'aiContext', 'faqs', 'confidenceThreshold',
          'onboarding', 'aiMacros', 'notifications', 'ownerEmail', 'updatedAt',
          'aiPromptVariant', 'aiIntegrations'
        ]);
    }

    function createOmitsServerFields() {
      return !request.resource.data.keys().hasAny([
        'billing', 'usage', 'metaAccessToken', 'tiktokAccessToken',
        'tiktokApiBase', 'tiktokSendPath'
      ]);
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['name', 'channel', 'externalId', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.channel in ['whatsapp', 'instagram', 'facebook', 'webchat', 'tiktok'] &&
             data.externalId is string && data.externalId.size() > 0 && data.externalId.size() < 50;
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['customerId', 'status', 'createdAt', 'updatedAt']) &&
             data.customerId is string &&
             data.status in ['active', 'human_escalated', 'closed'];
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'senderType', 'content', 'type', 'timestamp']) &&
             data.senderType in ['customer', 'agent', 'ai'] &&
             data.content is string && data.content.size() < 5000 &&
             data.type in ['text', 'image', 'audio', 'video', 'document', 'sticker', 'location', 'contacts', 'interactive', 'voice'];
    }

    function isValidSegment(data) {
      return data.keys().hasAll(['name', 'criteria', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.criteria is map;
    }

    function isValidTemplate(data) {
      let isMeta = data.keys().hasAll(['channelScope']) && data.channelScope == 'whatsapp_meta';
      return data.keys().hasAll(['name', 'content', 'type', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.content is string && data.content.size() < 5000 &&
             data.type in ['text', 'image'] &&
             (
               (isMeta &&
                 data.keys().hasAll(['metaTemplateName']) &&
                 data.metaTemplateName is string &&
                 data.metaTemplateName.size() > 0 &&
                 data.metaTemplateName.size() < 200) ||
               (!isMeta && data.content.size() > 0)
             );
    }

    function isValidBroadcast(data) {
      return data.keys().hasAll(['name', 'templateId', 'segmentId', 'status', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.templateId is string &&
             data.segmentId is string &&
             data.status in ['draft', 'scheduled', 'sending', 'sent', 'failed', 'cancelled'];
    }

    match /businesses/{businessId} {
      allow read: if isAuthenticated() && (businessId == request.auth.uid || isBusinessOwner(businessId) || isAgent(businessId));
      allow create: if isAuthenticated() &&
                    (request.resource.data.ownerEmail == request.auth.token.email || isPlatformAdmin()) &&
                    createOmitsServerFields();
      allow update: if isAuthenticated() &&
                    (businessId == request.auth.uid || isBusinessOwner(businessId)) &&
                    clientSafeBusinessKeys();
      allow delete: if isBusinessOwner(businessId);

      // Channel secrets — Admin SDK only
      match /private/{docId} {
        allow read, write: if false;
      }

      match /customers/{customerId} {
        allow read: if isBusinessOwner(businessId) || isAgent(businessId);
        allow create, update: if (isBusinessOwner(businessId) || isAgent(businessId)) && isValidCustomer(request.resource.data);
        allow delete: if isAdmin(businessId);

        match /private/{docId} {
          allow read, write: if false;
        }
      }

      match /conversations/{conversationId} {
        allow read: if isBusinessOwner(businessId) || isAgent(businessId);
        allow create, update: if (isBusinessOwner(businessId) || isAgent(businessId)) && isValidConversation(request.resource.data);
        allow delete: if isAdmin(businessId);

        match /messages/{messageId} {
          allow read: if isBusinessOwner(businessId) || isAgent(businessId);
          allow create: if (isBusinessOwner(businessId) || isAgent(businessId)) && isValidMessage(request.resource.data);
          allow update, delete: if isAdmin(businessId);
        }
      }

      match /agents/{agentId} {
        allow read: if isBusinessOwner(businessId) || isAgent(businessId) || agentId == request.auth.uid;
        allow create, update, delete: if isBusinessOwner(businessId);
      }

      match /invites/{inviteId} {
        allow read, delete: if isAdmin(businessId);
        allow create, update: if isBusinessOwner(businessId);
      }

      match /segments/{segmentId} {
        allow read: if isBusinessOwner(businessId) || isAgent(businessId);
        allow create, update, delete: if isAdmin(businessId) && isValidSegment(request.resource.data);
      }

      match /templates/{templateId} {
        allow read: if isBusinessOwner(businessId) || isAgent(businessId);
        allow create, update, delete: if isAdmin(businessId) && isValidTemplate(request.resource.data);
      }

      match /broadcasts/{broadcastId} {
        allow read: if isBusinessOwner(businessId) || isAgent(businessId);
        allow create, update, delete: if isAdmin(businessId) && isValidBroadcast(request.resource.data);
      }

      match /stats/{statId} {
        allow read: if isBusinessOwner(businessId) || isAgent(businessId);
        allow write: if false;
      }

      match /digest_events/{eventId} {
        allow read: if isBusinessOwner(businessId) || isAdmin(businessId);
        allow write: if false;
      }

      match /knowledge/{docId} {
        allow read: if isBusinessOwner(businessId) || isAgent(businessId);
        allow write: if false;
      }

      match /knowledge_chunks/{chunkId} {
        allow read, write: if false;
      }

      match /workflows/{ruleId} {
        allow read: if isBusinessOwner(businessId) || isAgent(businessId);
        allow write: if false;
      }

      match /ai_feedback/{feedbackId} {
        allow read: if isBusinessOwner(businessId) || isAgent(businessId);
        allow write: if false;
      }

      match /ai_improvement_hints/{hintId} {
        allow read: if isBusinessOwner(businessId) || isAdmin(businessId);
        allow write: if false;
      }

      match /webchat_outbox/{msgId} {
        allow read, write: if false;
      }
    }

    // Provider ID → businessId map (Admin SDK only)
    match /channel_bindings/{bindingId} {
      allow read, write: if false;
    }

    match /admins/{adminId} {
      allow read: if isAuthenticated() && request.auth.uid == adminId;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
