# ─── Server ───────────────────────────────────────────────────────────────────
# Local dev often uses 3040 so Vite can proxy /api to the same port (see frontend/vite.config.ts).
# Docker image defaults to 3000 (see docker-compose.yml).
PORT=3040
NODE_ENV=development

# Optional: mark staging-specific queue TLS behavior when NODE_ENV=staging
# STAGING=true

# ─── Security ─────────────────────────────────────────────────────────────────
# Required: 32+ character string to verify webhook signatures securely
WEBHOOK_SECRET=your_secret_here_must_be_thirty_two_chars
# Meta Verification Token (set in Meta Developer Portal)
WEBHOOK_VERIFY_TOKEN=your_meta_verification_token
# WhatsApp Phone Number ID (from WhatsApp Business display)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
# Meta Access Token (System User Token with messaging permissions)
META_ACCESS_TOKEN=your_meta_access_token
# TikTok Access Token (used for outbound TikTok replies)
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
# TikTok API base URL and send path (optional override)
TIKTOK_API_BASE=https://open.tiktokapis.com/v2
TIKTOK_SEND_PATH=/message/send/
# TikTok webhook signature secret (for inbound verification)
TIKTOK_WEBHOOK_SECRET=your_tiktok_webhook_secret

# Staging/production: protect GET /api/logs and GET /api/metrics (send header X-Observability-Key)
# Min 16 characters. Omitted in development/test keeps those endpoints open locally.
# OBSERVABILITY_KEY=your_long_random_observability_secret

# ─── AI ───────────────────────────────────────────────────────────────────────
# Required: Your Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Redis (BullMQ broker) ────────────────────────────────────────────────────
# IMPORTANT: Requires Redis 6.2+ (BullMQ 5.x requirement)
# Check version: redis-cli INFO server | grep redis_version
#
# Local:           redis://localhost:6379
# With password:   redis://:password@hostname:6379
# With TLS:        rediss://username:password@hostname:6380
# AWS ElastiCache: redis://your-cluster.cache.amazonaws.com:6379
# Google Cloud:    redis://10.0.0.3:6379
REDIS_URL=redis://localhost:6379

# ─── EMR API ──────────────────────────────────────────────────────────────────
# Replace with your real EMR host; *.example.com is treated as not configured in /api/health.
EMR_API_URL=https://api.emr.example.com
EMR_API_KEY=your_emr_api_key_here
EMR_TIMEOUT_MS=10000

# ─── Queue ────────────────────────────────────────────────────────────────────
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
# Local development default:
QUEUE_STRICT_MODE=false
# Staging/production recommended value:
# QUEUE_STRICT_MODE=true

# Run BullMQ workers inside the API process (default on in development). For staging/prod use separate worker.
# INLINE_WORKERS_IN_SERVER=false

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQ=60
RATE_LIMIT_AI_MAX_REQ=30
RATE_LIMIT_EMR_MAX_REQ=10

# ─── App / CORS ─────────────────────────────────────────────────────────────
# Exact browser origin(s) of the dashboard, comma-separated (required when NODE_ENV is staging/production).
ALLOWED_ORIGINS=http://localhost:5173
# Base URL of the web app (team invite links, redirects). Must match how users open the dashboard.
APP_URL=http://localhost:5173
SMTP_API_URL=https://api.sendgrid.com/v3/mail/send
# SendGrid (or compatible) API key — required when using SendGrid URL
SMTP_API_KEY=your_sendgrid_api_key
SMTP_FROM_EMAIL=noreply@snapshop.ai

# ─── Stripe billing (optional until go-live) ──────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_SCALE=price_...

# ─── Error monitoring (optional) ──────────────────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...
# VITE_SENTRY_DSN=https://...@sentry.io/...

# ─── Firebase (backend) ───────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
# JSON string of service account, or rely on GOOGLE_APPLICATION_CREDENTIALS in cloud environments
# FIREBASE_SERVICE_ACCOUNT_KEY=

# ─── Firebase Frontend (Vite build) ───────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=snapshop-2bd87.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=snapshop-2bd87
VITE_FIREBASE_STORAGE_BUCKET=snapshop-2bd87.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=821516476451
VITE_FIREBASE_APP_ID=1:821516476451:web:86d6cab7fa8bc99d051196
VITE_FIREBASE_FIRESTORE_DATABASE_ID=snapshop-2bd87-service
# When the dashboard is hosted on a different origin than the API, set at build time (e.g. staging CDN → API host).
# VITE_API_BASE_URL=https://api.your-staging-domain.com
